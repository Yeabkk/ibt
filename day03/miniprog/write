
names = ["Abebe Kebede", "Tigist Alemayehu", "Dawit Tesfaye"]


with open("names.txt", "w") as file:
    for name in names:
        file.write(name + "\n")

print(" Names written to names.txt")
print(f"  Wrote {len(names)} names\n")

print("Reading names from names.txt:")

with open("names.txt", "r") as file:
    for line_num, name in enumerate(file, 1):
        
        print(f"{line_num}. {name.strip()}")
